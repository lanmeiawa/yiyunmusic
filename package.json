{
  "name": "yiyunmusic",
  "version": "2.2.4",
  "private": true,
  "description": "把动态歌词做到极致的网易云音乐第三方桌面客户端",
  "homepage": "https://github.com/lanmeiawa/yiyunmusic",
  "author": "yiyunmusic",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.js --dev",
    "start": "node scripts/launch.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:portable": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "5.2.0",
    "hls.js": "^1.7.4",
    "NeteaseCloudMusicApi": "^4.34.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx": "^1.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.yiyun.music",
    "productName": "yiyunmusic",
    "copyright": "Copyright © 2026 yiyunmusic",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/sherpa-onnx/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "yiyunmusic-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "yiyunmusic",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "yiyunmusic-portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "executableName": "yiyunmusic",
      "artifactName": "yiyunmusic-${version}-${arch}.${ext}",
      "synopsis": "动态歌词体验最强的网易云音乐第三方客户端",
      "maintainer": "yiyunmusic"
    }
  },
  "license": "MIT"
}
